MONGO_URI=mongodb://127.0.0.1:27017/learnly
JWT_SECRET=change-me-to-a-long-random-string
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you set when creating the webhook in the Razorpay dashboard (different from the key secret).
RAZORPAY_WEBHOOK_SECRET=
APP_URL=http://localhost:3000
# Email through Gmail with OAuth 2.0 (nodemailer). All four GMAIL_* values go together and are required in production.
# In development leave them empty and emails (with their links) are printed to the server console. Setup: see the README.
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Optional. Defaults to "Learnly <GMAIL_USER>". Gmail rewrites any address that is not the account or one of its aliases.
EMAIL_FROM=
# Sign in with Google (optional; both together). Authorized redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Long random string the scheduler sends as a Bearer token to POST /api/internal/cleanup-uploads.
CRON_SECRET=
# Optional. Only if "querySrv ECONNREFUSED" appears locally (VPN/WARP/DNS proxy). Leave unset in production.
# DNS_SERVERS=8.8.8.8,1.1.1.1
