MONGO_URI=mongodb://127.0.0.1:27017/learnly
JWT_SECRET=change-me-to-a-long-random-string
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you set when creating the webhook in the Razorpay dashboard (different from the key secret).
RAZORPAY_WEBHOOK_SECRET=
APP_URL=http://localhost:3000
# Transactional email over SMTP (nodemailer). SMTP_HOST and EMAIL_FROM are required in production.
# In development leave SMTP_HOST empty and emails (with their links) are printed to the server console.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (port 465); false for STARTTLS or plain (587, 25). Leave empty to default by port.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Learnly <no-reply@your-domain.com>
# Long random string the scheduler sends as a Bearer token to POST /api/internal/cleanup-uploads.
CRON_SECRET=
# Optional. Only if "querySrv ECONNREFUSED" appears locally (VPN/WARP/DNS proxy). Leave unset in production.
# DNS_SERVERS=8.8.8.8,1.1.1.1
